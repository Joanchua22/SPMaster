<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Dashboard.master.cs"
    Inherits="SPMaster.Dashboard" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>SPMaster Admin</title>

    <link runat="server" href="~/Content/Dashboard.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <asp:ContentPlaceHolder ID="DashboardHead" runat="server" />
</head>

<body>
    <form id="dashboardForm" runat="server">

        <a href="#dashboard-content" class="skip-link">
            Skip to content
        </a>

        <div class="dashboard-layout">

            <%-- ADMIN SIDEBAR --%>
            <aside id="dashboardSidebar" class="sidebar" aria-label="Admin sidebar">

                <button type="button" id="dashboardMenuClose" class="dashboard-menu-close" aria-label="Close navigation">
                    <i class="bi bi-x" aria-hidden="true"></i>
                </button>

                <a href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>" class="dashboard-brand">
                    <img src="<%= ResolveUrl("~/Images/spmaster-logo.png") %>" alt="SPMaster admin dashboard" class="dashboard-logo" />
                </a>

                <p class="menu-heading">Main Menu</p>

                <%-- Shared admin navigation --%>
                <asp:ContentPlaceHolder ID="DashboardNavigation" runat="server">

                    <nav class="sidebar-nav" aria-label="Admin navigation">

                        <a href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>" class="nav-item">
                            <span class="nav-icon" aria-hidden="true">
                                <i class="bi bi-grid"></i>
                            </span>
                            <span>Dashboard</span>
                        </a>

                        <a href="<%= ResolveUrl("~/Admin/UserManagement.aspx") %>" class="nav-item">
                            <span class="nav-icon" aria-hidden="true">
                                <i class="bi bi-people"></i>
                            </span>
                            <span>User Management</span>
                        </a>

                        <a href="<%= ResolveUrl("~/Admin/ContentAudit.aspx") %>" class="nav-item">
                            <span class="nav-icon" aria-hidden="true">
                                <i class="bi bi-file-earmark-text"></i>
                            </span>
                            <span>Content Audit</span>
                        </a>

                        <a href="<%= ResolveUrl("~/Admin/FeedbackReports.aspx") %>" class="nav-item">
                            <span class="nav-icon" aria-hidden="true">
                                <i class="bi bi-chat-left-text"></i>
                            </span>
                            <span>Feedback &amp; Reports</span>
                        </a>

                    </nav>

                </asp:ContentPlaceHolder>

                <%-- ACCOUNT NAVIGATION --%>
                <div class="sidebar-bottom">

                    <asp:ContentPlaceHolder ID="DashboardAccountNavigation" runat="server">

                        <nav aria-label="Admin account navigation">

                            <a href="<%= ResolveUrl("~/Admin/Profile.aspx") %>" class="nav-item">
                                <span class="nav-icon" aria-hidden="true">
                                    <i class="bi bi-person-circle"></i>
                                </span>
                                <span>Profile</span>
                            </a>

                            <a href="<%= ResolveUrl("~/Admin/Settings.aspx") %>" class="nav-item">
                                <span class="nav-icon" aria-hidden="true">
                                    <i class="bi bi-gear"></i>
                                </span>
                                <span>Settings</span>
                            </a>
                        </nav>
                    </asp:ContentPlaceHolder>
                </div>
            </aside>

            <%-- Mobile sidebar backdrop --%>
            <div id="dashboardMenuOverlay" class="dashboard-menu-overlay" aria-hidden="true" hidden></div>

            <div class="dashboard-main">

                <%-- TOP BAR --%>
                <header class="dashboard-topbar">

                    <button type="button" id="dashboardMenuToggle" class="dashboard-menu-toggle" aria-label="Open navigation" aria-controls="dashboardSidebar" aria-expanded="false">
                        <span aria-hidden="true">☰</span>
                    </button>

                    <div class="topbar-heading">

                        <time class="dashboard-date" datetime="<%= DateTime.UtcNow.AddHours(8).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) %>">
                            <%= DateTime.UtcNow.AddHours(8).ToString("dddd, d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-MY")) %>
                        </time>

                        <h1 class="dashboard-title">
                            <asp:ContentPlaceHolder ID="DashboardTitle" runat="server">
                                Admin Dashboard
                            </asp:ContentPlaceHolder>
                        </h1>

                    </div>

                    <div class="topbar-actions">

                        <%-- Sample account details until connected to login --%>
                        <asp:ContentPlaceHolder ID="DashboardUser" runat="server">

                            <div class="user-summary">
                                <span class="user-avatar" aria-hidden="true">
                                    AD
                                </span>

                                <div class="user-details">
                                    <span class="user-name">Admin</span>
                                    <span class="user-role">Admin</span>
                                </div>
                            </div>

                        </asp:ContentPlaceHolder>

                        <button type="button" class="topbar-icon-button" aria-label="Notifications — coming soon" title="Notifications — coming soon" disabled>
                            <i class="bi bi-bell" aria-hidden="true"></i>
                        </button>

                    </div>
                </header>

                <%-- CONTENT FROM THE CURRENT ADMIN PAGE --%>
                <main id="dashboard-content" class="dashboard-content" tabindex="-1">
                    <asp:ContentPlaceHolder ID="DashboardContent" runat="server" />
                </main>

            </div>
        </div>

        <asp:ContentPlaceHolder ID="DashboardScripts" runat="server" />

    </form>

    <script>
        // Mobile sidebar.
        (function () {
            const layout = document.querySelector(".dashboard-layout");
            const sidebar = document.getElementById("dashboardSidebar");
            const main = document.querySelector(".dashboard-main");
            const openButton = document.getElementById("dashboardMenuToggle");
            const closeButton = document.getElementById("dashboardMenuClose");
            const overlay = document.getElementById("dashboardMenuOverlay");

            if (!layout || !sidebar || !main ||!openButton || !closeButton || !overlay) {
                return;
            }

            const smallScreen = window.matchMedia("(max-width: 1000px)");
            let isOpen = false;

            function openMenu() {
                if (!smallScreen.matches) return;

                isOpen = true;
                layout.classList.add("mobile-menu-open");
                document.body.classList.add("dashboard-menu-open");

                overlay.hidden = false;
                openButton.setAttribute("aria-expanded", "true");

                closeButton.focus();
                main.inert = true;
            }

            function closeMenu(restoreFocus) {
                isOpen = false;
                main.inert = false;

                if (restoreFocus && smallScreen.matches) {
                    openButton.focus();
                }

                layout.classList.remove("mobile-menu-open");
                document.body.classList.remove("dashboard-menu-open");

                overlay.hidden = true;
                openButton.setAttribute("aria-expanded", "false");
            }

            openButton.addEventListener("click", openMenu);

            closeButton.addEventListener("click", function () {
                closeMenu(true);
            });

            overlay.addEventListener("click", function () {
                closeMenu(true);
            });

            document.addEventListener("keydown", function (event) {
                if (!isOpen) return;

                if (event.key === "Escape") {
                    event.preventDefault();
                    closeMenu(true);
                    return;
                }

                if (event.key === "Tab") {
                    const items = Array.from(sidebar.querySelectorAll('a[href], button:not([disabled]), [tabindex="0"]'
                    )).filter(function (item) {
                        return item.getClientRects().length > 0;
                    });

                    const first = items[0];
                    const last = items[items.length - 1];

                    if (!first) return;

                    if (event.shiftKey && document.activeElement === first) {
                        event.preventDefault();
                        last.focus();
                    } else if (!event.shiftKey && document.activeElement === last) {
                        event.preventDefault();
                        first.focus();
                    }
                }
            });

            smallScreen.addEventListener("change", function () {
                const focusInSidebar = sidebar.contains(document.activeElement);

                const focusOnMobileControl = document.activeElement === openButton || document.activeElement === closeButton;

                closeMenu(smallScreen.matches && focusInSidebar);

                if (!smallScreen.matches && focusOnMobileControl) {
                    const firstLink = sidebar.querySelector("a[href]");
                    if (firstLink) firstLink.focus();
                }
            });
        })();

        // Highlight the navigation link for the current page.
        (function () {
            const currentPath = window.location.pathname.toLowerCase();

            const links = document.querySelectorAll("#dashboardSidebar a.nav-item[href]");

            links.forEach(function (link) {
                const url = new URL(link.href, window.location.href);

                const isCurrentPage = url.origin === window.location.origin && url.pathname.toLowerCase() === currentPath;

                link.classList.toggle("active", isCurrentPage);

                if (isCurrentPage) {
                    link.setAttribute("aria-current", "page");
                } else {
                    link.removeAttribute("aria-current");
                }
            });
        })();
    </script>
</body>
</html>