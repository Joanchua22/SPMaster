<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Dashboard.master.cs" Inherits="SPMaster.Dashboard" %>

<!DOCTYPE html>

<html>

<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SPMaster Dashboard</title>
    <link runat="server" href="~/Content/Dashboard.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <asp:ContentPlaceHolder ID="DashboardHead" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form id="dashboardForm" runat="server">
        <a href="#dashboard-content" class="skip-link">
            Skip to content
        </a>

        <div class="dashboard-layout">

            <%-- SIDEBAR --%>
            <aside id="dashboardSidebar" class="sidebar" aria-label="Dashboard Sidebar">

                <button type="button" id="dashboardMenuClose" class="dashboard-menu-close" aria-label="Close navigation">
                    <i class="bi bi-x" aria-hidden="true"></i>
                </button>

                <%-- LOGO --%>
                <a href="<%= ResolveUrl("~/Home.aspx") %>" class="dashboard-brand">
                    <img src="<%= ResolveUrl("~/Images/spmaster-logo.png") %>" alt="SPMaster home" class="dashboard-logo" />
                </a>

                <p class="menu-heading">Main Menu</p>

                <%--Student Navigation as Default. Lecturer & Admin pages can replace this placeholder--%>
                <asp:ContentPlaceHolder ID="DashboardNavigation" runat="server">

                    <nav class="sidebar-nav" aria-label="Main navigation">

                        <a href="<%= ResolveUrl("~/Student/Dashboard.aspx") %>" class="nav-item">
                            <span class="nav-icon" aria-hidden="true">○</span>
                            <span>Dashboard</span>
                        </a>

                        <a href="<%= ResolveUrl("~/Student/Quizzes.aspx") %>" class="nav-item">
                            <span class="nav-icon" aria-hidden="true">○</span>
                            <span>My Quizzes</span>
                        </a>

                        <a href="<%= ResolveUrl("~/Student/Performance.aspx") %>" class="nav-item">
                            <span class="nav-icon" aria-hidden="true">○</span>
                            <span>Performance</span>
                        </a>

                        <a href="<%= ResolveUrl("~/Student/Hints.aspx") %>" class="nav-item">
                            <span class="nav-icon" aria-hidden="true">○</span>
                            <span>Hints &amp; Formulas</span>
                        </a>

                        <a href="<%= ResolveUrl("~/Student/Feedback.aspx") %>" class="nav-item">
                            <span class="nav-icon" aria-hidden="true">○</span>
                            <span>Feedback</span>
                        </a>

                    </nav>

                </asp:ContentPlaceHolder>

                <%-- Bottom sidebar links --%>
                <div class="sidebar-bottom">

                    <asp:ContentPlaceHolder ID="DashboardAccountNavigation" runat="server">

                        <nav aria-label="Account navigation">

                            <a href="<%= ResolveUrl("~/Student/Profile.aspx") %>" class="nav-item">
                                <span class="nav-icon" aria-hidden="true">○</span>
                                <span>Profile</span>
                            </a>

                            <a href="<%= ResolveUrl("~/Student/Settings.aspx") %>" class="nav-item">
                                <span class="nav-icon" aria-hidden="true">○</span>
                                <span>Settings</span>
                            </a>

                        </nav>

                    </asp:ContentPlaceHolder>


                </div>

            </aside>

            <div id="dashboardMenuOverlay" class="dashboard-menu-overlay" aria-hidden="true" hidden> </div>

            <%-- MAIN AREA --%>
            <div class="dashboard-main">

                <%-- TOP BAR --%>
                <header class="dashboard-topbar">

                    <button type="button" id="dashboardMenuToggle" class="dashboard-menu-toggle" aria-label="Open navigation" aria-controls="dashboardSidebar" aria-expanded="false">
                        <span aria-hidden="true">☰</span>
                    </button>

                    <div class="topbar-heading">

                        <time class="dashboard-date" datetime="<%= DateTime.UtcNow.AddHours(8).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) %>">
                            <%= DateTime.UtcNow.AddHours(8).ToString("dddd, d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-MY")) %>
                        </time>

                        <h1 class="dashboard-title">

                            <asp:ContentPlaceHolder ID="DashboardTitle" runat="server"> My Dashboard </asp:ContentPlaceHolder>

                        </h1>

                    </div>

                    <div class="topbar-actions">

                        <%-- Hard-coded account details for now --%>
                        <asp:ContentPlaceHolder ID="DashboardUser" runat="server">

                            <div class="user-summary">

                                <span class="user-avatar" aria-hidden="true">
                                    AL
                                </span>

                                <div class="user-details">
                                    <span class="user-name">Aina Lee</span>
                                    <span class="user-role">Student</span>
                                </div>

                            </div>

                        </asp:ContentPlaceHolder>

                        <%-- Notification function will be added later --%>
                        <button type="button" class="topbar-icon-button" aria-label="Notifications — coming soon" title="Notifications — coming soon" disabled>

                            <i class="bi bi-bell" aria-hidden="true"></i>

                        </button>

                    </div>

                </header>

                <%-- CONTENT FROM STUDENT, LECTURER OR ADMIN PAGES --%>
                <main id="dashboard-content" class="dashboard-content" tabindex="-1">

                    <asp:ContentPlaceHolder ID="DashboardContent" runat="server" />

                </main>

            </div>

        </div>

        <%-- Optional JavaScript for individual pages --%>
        <asp:ContentPlaceHolder ID="DashboardScripts" runat="server" />

    </form>

    <script>
        (function() {
            const layout = document.querySelector(".dashboard-layout");
            const sidebar = document.getElementById("dashboardSidebar");
            const main = document.querySelector(".dashboard-main");
            const openButton = document.getElementById("dashboardMenuToggle");
            const closeButton = document.getElementById("dashboardMenuClose");
            const overlay = document.getElementById("dashboardMenuOverlay");

            if (!layout || !sidebar || !main ||
                !openButton || !closeButton || !overlay) {
                return;
            }

            const smallScreen = window.matchMedia("(max-width: 1000px)");
            let isOpen = false;

            function openMenu() {
                if (!smallScreen.matches) return;

                isOpen = true;
                layout.classList.add("mobile-menu-open");
                document.body.classList.add("dashboard-menu-open");

                overlay.hidden = false;
                openButton.setAttribute("aria-expanded", "true");

                closeButton.focus();

                // Prevent interaction with content behind the sidebar.
                main.inert = true;
            }

            function closeMenu(restoreFocus) {
                isOpen = false;
                main.inert = false;

                if (restoreFocus && smallScreen.matches) {
                    openButton.focus();
                }

                layout.classList.remove("mobile-menu-open");
                document.body.classList.remove("dashboard-menu-open");

                overlay.hidden = true;
                openButton.setAttribute("aria-expanded", "false");
            }

            openButton.addEventListener("click", openMenu);

            closeButton.addEventListener("click", function() {
                closeMenu(true);
            });

            overlay.addEventListener("click", function() {
                closeMenu(true);
            });

            document.addEventListener("keydown", function(event) {
                if (!isOpen) return;

                if (event.key === "Escape") {
                    event.preventDefault();
                    closeMenu(true);
                    return;
                }

                // Keep keyboard focus inside the open sidebar.
                if (event.key === "Tab") {
                    const items = Array.from(sidebar.querySelectorAll(
                        'a[href], button:not([disabled]), [tabindex="0"]'
                    )).filter(function(item) {
                        return item.getClientRects().length > 0;
                    });

                    const first = items[0];
                    const last = items[items.length - 1];

                    if (!first) return;

                    if (event.shiftKey &&
                        document.activeElement === first) {
                        event.preventDefault();
                        last.focus();
                    } else if (!event.shiftKey &&
                        document.activeElement === last) {
                        event.preventDefault();
                        first.focus();
                    }
                }
            });

            smallScreen.addEventListener("change", function() {
                const focusInSidebar =
                    sidebar.contains(document.activeElement);

                const focusOnMobileControl =
                    document.activeElement === openButton ||
                    document.activeElement === closeButton;

                closeMenu(smallScreen.matches && focusInSidebar);

                // Mobile-only buttons disappear when returning to desktop.
                if (!smallScreen.matches && focusOnMobileControl) {
                    const firstLink = sidebar.querySelector("a[href]");
                    if (firstLink) firstLink.focus();
                }
                    });
                })();

        (function () {
            const currentPath = window.location.pathname.toLowerCase();

            const menuLinks = document.querySelectorAll("#dashboardSidebar a.nav-item[href]");

            menuLinks.forEach(function (link) {
                const linkUrl = new URL(link.href, window.location.href);

                const isCurrentPage = linkUrl.origin === window.location.origin && linkUrl.pathname.toLowerCase() === currentPath;

                link.classList.toggle("active", isCurrentPage);

                if (isCurrentPage) {
                    link.setAttribute("aria-current", "page");
                } else {
                    link.removeAttribute("aria-current");
                }
            });
        })();
    </script>
</body>
</html>
