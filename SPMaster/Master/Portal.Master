<%@ Master Language="C#"
    AutoEventWireup="true"
    CodeBehind="Portal.Master.cs"
    Inherits="SPMaster.Master.Portal" %>

<!DOCTYPE html>
<html lang="en">

<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />


    <title>
        SPMaster Portal
    </title>


    <link runat="server"
          href="~/Content/Portal.css?v=1"
          rel="stylesheet"
          type="text/css" />

    <link runat="server"
      href="~/Content/Account.css"
      rel="stylesheet"
      type="text/css" />


    <%-- Normal Portal page CSS --%>
    <asp:ContentPlaceHolder
        ID="PortalHead"
        runat="server">
    </asp:ContentPlaceHolder>


    <%-- Shared Account pages use this placeholder --%>
    <asp:ContentPlaceHolder
        ID="DashboardHead"
        runat="server">
    </asp:ContentPlaceHolder>

</head>


<body class="portal-body">


    <form id="portalForm"
          runat="server"
          class="portal-wrapper">


        <%-- =====================================================
             COMPATIBILITY PLACEHOLDERS

             Profile.aspx and Settings.aspx are shared with Admin.

             Admin uses Dashboard.Master.
             Student / Lecturer use Portal.Master.

             These hidden placeholders allow the same Account pages
             to work with both master pages.
             ===================================================== --%>

        <div style="display: none;">


            <asp:ContentPlaceHolder
                ID="DashboardTitle"
                runat="server">
            </asp:ContentPlaceHolder>


            <asp:ContentPlaceHolder
                ID="DashboardNavigation"
                runat="server">
            </asp:ContentPlaceHolder>


            <asp:ContentPlaceHolder
                ID="DashboardAccountNavigation"
                runat="server">
            </asp:ContentPlaceHolder>


            <asp:ContentPlaceHolder
                ID="DashboardUser"
                runat="server">
            </asp:ContentPlaceHolder>


        </div>



        <%-- =====================================================
             SKIP LINK
             ===================================================== --%>

        <a href="#portal-content"
           class="portal-skip-link">

            Skip to content

        </a>



        <%-- =====================================================
             SHARED HEADER
             ===================================================== --%>

        <header class="portal-header">


            <div class="portal-header-inner">


                <%-- LOGO --%>

                <a href="<%= ResolveUrl(PortalFolder + "Portal.aspx") %>"
                   class="portal-brand">

                    <img src="<%= ResolveUrl("~/Images/spmaster-logo.png") %>"
                         alt="SPMaster dashboard"
                         class="portal-logo" />

                </a>



                <%-- =================================================
                     MAIN NAVIGATION
                     ================================================= --%>

                <div id="portalMenu"
                     class="portal-menu">


                    <nav class="portal-nav"
                         aria-label="Main navigation">


                        <%-- =========================================
                             LECTURER NAVIGATION
                             ========================================= --%>

                        <% if (IsLecturer) { %>


                            <a href="<%= ResolveUrl("~/Lecturer/Portal.aspx") %>">

                                Dashboard

                            </a>


                            <a href="<%= ResolveUrl("~/Lecturer/QuestionBank.aspx") %>">

                                Question Bank

                            </a>


                            <a href="<%= ResolveUrl("~/Lecturer/Quizzes.aspx") %>">

                                Quizzes

                            </a>


                            <a href="<%= ResolveUrl("~/Lecturer/Sessions.aspx") %>">

                                Sessions

                            </a>


                            <a href="<%= ResolveUrl("~/Lecturer/Grading.aspx") %>">

                                Grading

                            </a>


                            <a href="<%= ResolveUrl("~/Lecturer/Performance.aspx") %>">

                                Performance

                            </a>


                            <a href="<%= ResolveUrl("~/Feedback.aspx") %>">

                                Feedback

                            </a>


                        <% } else { %>


                            <%-- =====================================
                                 STUDENT NAVIGATION
                                 ===================================== --%>


                            <a href="<%= ResolveUrl("~/Student/Portal.aspx") %>">

                                Dashboard

                            </a>


                            <a href="<%= ResolveUrl("~/Student/Quizzes.aspx") %>">

                                Quizzes

                            </a>


                            <a href="<%= ResolveUrl("~/Student/Performance.aspx") %>">

                                Performance

                            </a>


                            <a href="<%= ResolveUrl("~/Feedback.aspx") %>">

                                Feedback

                            </a>


                        <% } %>


                    </nav>


                </div>



                <%-- =================================================
                     ACCOUNT AREA
                     ================================================= --%>

                <div class="portal-header-actions">


                    <div class="portal-account"
                         id="portalAccount">


                        <button type="button"
                                id="portalAccountToggle"
                                class="portal-account-toggle"
                                aria-controls="portalAccountMenu"
                                aria-expanded="false">


                            <span class="portal-avatar"
                                  aria-hidden="true">

                                <%= UserInitials %>

                            </span>


                            <span class="portal-user-name">

                                <%= DisplayName %>

                            </span>


                            <span class="portal-chevron"
                                  aria-hidden="true">

                                ▾

                            </span>


                        </button>



                        <%-- ACCOUNT DROPDOWN --%>

                        <div id="portalAccountMenu"
                             class="portal-account-menu"
                             hidden>


                            <div class="portal-account-info">

                                <strong>

                                    <%= DisplayName %>

                                </strong>


                                <span>

                                    <%= DisplayRole %>

                                </span>

                            </div>



                            <nav aria-label="Account navigation">


                                <a href="<%= ResolveUrl("~/Account/Profile.aspx") %>">

                                    Profile

                                </a>


                                <a href="<%= ResolveUrl("~/Account/Settings.aspx") %>">

                                    Settings

                                </a>


                            </nav>


                        </div>


                    </div>



                    <%-- MOBILE MENU BUTTON --%>

                    <button type="button"
                            id="portalMenuToggle"
                            class="portal-menu-toggle"
                            aria-label="Open navigation menu"
                            aria-controls="portalMenu"
                            aria-expanded="false">

                        <span></span>
                        <span></span>
                        <span></span>

                    </button>


                </div>


            </div>


        </header>



        <%-- =====================================================
             PAGE CONTENT
             ===================================================== --%>

        <main id="portal-content"
              class="portal-main"
              tabindex="-1">


            <%-- =============================================
                 NORMAL STUDENT / LECTURER PAGES
                 ============================================= --%>

            <asp:ContentPlaceHolder
                ID="PortalContent"
                runat="server">
            </asp:ContentPlaceHolder>



            <%-- =============================================
                 SHARED PROFILE / SETTINGS PAGES
                 ============================================= --%>

            <asp:ContentPlaceHolder
                ID="DashboardContent"
                runat="server">
            </asp:ContentPlaceHolder>


        </main>



        <%-- =====================================================
             SHARED FOOTER
             ===================================================== --%>

        <footer class="portal-footer">


            <div class="portal-footer-inner">


                <p class="portal-copyright">

                    &copy;
                    <%= DateTime.UtcNow.AddHours(8).Year %>

                    SPMaster. All rights reserved.

                </p>


            </div>


        </footer>



        <%-- =====================================================
             SHARED ACCOUNT PAGE SCRIPTS

             Profile.aspx / Settings.aspx currently use
             DashboardScripts.
             ===================================================== --%>

        <asp:ContentPlaceHolder
            ID="DashboardScripts"
            runat="server">
        </asp:ContentPlaceHolder>



        <%-- Normal Portal page scripts --%>

        <asp:ContentPlaceHolder
            ID="PortalScripts"
            runat="server">
        </asp:ContentPlaceHolder>


    </form>



    <%-- =========================================================
         PORTAL JAVASCRIPT
         ========================================================= --%>

    <script>

        (function () {

            const menu =
                document.getElementById(
                    "portalMenu"
                );


            const menuToggle =
                document.getElementById(
                    "portalMenuToggle"
                );


            const header =
                document.querySelector(
                    ".portal-header-inner"
                );


            const account =
                document.getElementById(
                    "portalAccount"
                );


            const accountToggle =
                document.getElementById(
                    "portalAccountToggle"
                );


            const accountMenu =
                document.getElementById(
                    "portalAccountMenu"
                );


            const smallScreen =
                window.matchMedia(
                    "(max-width: 1000px)"
                );



            // =============================================
            // CLOSE NAVIGATION
            // =============================================

            function closeNavigation(
                returnFocus
            ) {

                if (returnFocus) {

                    menuToggle.focus();

                }


                menu.classList.remove(
                    "is-open"
                );


                menuToggle.setAttribute(
                    "aria-expanded",
                    "false"
                );


                menuToggle.setAttribute(
                    "aria-label",
                    "Open navigation menu"
                );

            }



            // =============================================
            // CLOSE ACCOUNT MENU
            // =============================================

            function closeAccount(
                returnFocus
            ) {

                if (returnFocus) {

                    accountToggle.focus();

                }


                accountMenu.hidden =
                    true;


                accountToggle.setAttribute(
                    "aria-expanded",
                    "false"
                );

            }



            // =============================================
            // MOBILE NAVIGATION
            // =============================================

            menuToggle.addEventListener(
                "click",
                function () {

                    const opening =
                        !menu.classList
                            .contains(
                                "is-open"
                            );


                    closeAccount(
                        false
                    );


                    menu.classList.toggle(
                        "is-open",
                        opening
                    );


                    menuToggle.setAttribute(
                        "aria-expanded",
                        String(opening)
                    );


                    menuToggle.setAttribute(
                        "aria-label",
                        opening
                            ? "Close navigation menu"
                            : "Open navigation menu"
                    );

                }
            );



            // =============================================
            // ACCOUNT DROPDOWN
            // =============================================

            accountToggle.addEventListener(
                "click",
                function () {

                    const opening =
                        accountMenu.hidden;


                    closeNavigation(
                        false
                    );


                    accountMenu.hidden =
                        !opening;


                    accountToggle.setAttribute(
                        "aria-expanded",
                        String(opening)
                    );

                }
            );



            // =============================================
            // CLICK OUTSIDE
            // =============================================

            document.addEventListener(
                "click",
                function (event) {

                    if (
                        !account.contains(
                            event.target
                        )
                    ) {

                        closeAccount(
                            accountMenu.contains(
                                document.activeElement
                            )
                        );

                    }


                    if (
                        !header.contains(
                            event.target
                        )
                    ) {

                        closeNavigation(
                            smallScreen.matches
                            &&
                            menu.contains(
                                document.activeElement
                            )
                        );

                    }

                }
            );



            // =============================================
            // ESCAPE KEY
            // =============================================

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key !==
                        "Escape"
                    ) {

                        return;

                    }


                    if (
                        !accountMenu.hidden
                    ) {

                        closeAccount(
                            true
                        );

                    }

                    else if (
                        menu.classList
                            .contains(
                                "is-open"
                            )
                    ) {

                        closeNavigation(
                            true
                        );

                    }

                }
            );



            // =============================================
            // KEYBOARD FOCUS
            // =============================================

            document.addEventListener(
                "focusin",
                function (event) {

                    if (
                        !account.contains(
                            event.target
                        )
                    ) {

                        closeAccount(
                            false
                        );

                    }


                    if (
                        !header.contains(
                            event.target
                        )
                    ) {

                        closeNavigation(
                            false
                        );

                    }

                }
            );



            // =============================================
            // SCREEN SIZE CHANGE
            // =============================================

            smallScreen.addEventListener(
                "change",
                function () {

                    const focusInMenu =
                        menu.contains(
                            document.activeElement
                        );


                    closeNavigation(
                        smallScreen.matches
                        &&
                        focusInMenu
                    );


                    closeAccount(
                        false
                    );


                    if (
                        !smallScreen.matches
                        &&
                        document.activeElement
                        === menuToggle
                    ) {

                        const firstLink =
                            menu.querySelector(
                                "a"
                            );


                        if (
                            firstLink
                        ) {

                            firstLink.focus();

                        }

                    }

                }
            );



            // =============================================
            // CURRENT PAGE NAVIGATION
            // =============================================

            const currentPath =
                window.location.pathname
                    .toLowerCase();


            document
                .querySelectorAll(
                    ".portal-nav a"
                )
                .forEach(
                    function (link) {

                        const linkUrl =
                            new URL(
                                link.href
                            );


                        if (
                            linkUrl.pathname
                                .toLowerCase()
                            ===
                            currentPath
                        ) {

                            link.classList.add(
                                "active"
                            );


                            link.setAttribute(
                                "aria-current",
                                "page"
                            );

                        }

                    }
                );

        })();

    </script>


</body>

</html>